    "PartReference": {
      "description": "A part number with its supersession and compatibility context.\n\nPart numbers are not simple strings -- they carry information about\nwhich parts they replace, which parts replace them, and which models\nand years they fit. This context is critical for cross-reference\nqueries (\"what other models use this part?\").",
      "properties": {
        "part_number": {
          "description": "Primary part number identifier (e.g. '6500-310', '73250')",
          "title": "Part Number",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "fits_models": {
          "items": {
            "type": "string"
          },
          "title": "Fits Models",
          "type": "array"
        },
        "fits_years": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fits Years"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "part_number"
      ],
      "title": "PartReference",
      "type": "object"
    },
