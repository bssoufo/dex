    "SourceReference": {
      "description": "Provenance tracking for a data point.\n\nEvery spec value in the system must be traceable back to a source\ndocument (PDF page, website URL, or manual entry). This enables\nverification and trust -- when a technician questions a value,\nwe can point to exactly where it came from.",
      "properties": {
        "source_type": {
          "enum": [
            "pdf",
            "website",
            "manual_entry"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "document_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Name"
        },
        "page_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "accessed_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessed Date"
