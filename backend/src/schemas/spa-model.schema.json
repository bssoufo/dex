        "total_jet_count": {
          "description": "Total number of jets in the spa",
          "title": "Total Jet Count",
          "type": "integer"
        },
        "jet_system_type": {
          "$ref": "#/$defs/JetSystemType",
          "default": "fixed"
        },
        "jets_by_type": {
